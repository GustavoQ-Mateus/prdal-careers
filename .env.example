# Portas expostas no host
WEB_PORT=5173
API_PORT=3000
AI_SERVICE_PORT=8000
DOC_SERVICE_PORT=8080
POSTGRES_PORT=5432
MONGO_PORT=27017

# URLs internas entre serviços (rede do docker-compose)
AI_SERVICE_URL=http://ai-service:8000
DOC_SERVICE_URL=http://doc-service:8080

# URL da api usada pelo browser (web)
VITE_API_URL=http://localhost:3000

# PostgreSQL (dono: api)
POSTGRES_USER=prdal
POSTGRES_PASSWORD=prdal
POSTGRES_DB=prdal_careers
DATABASE_URL=postgresql://prdal:prdal@postgres:5432/prdal_careers

# MongoDB (dono: api)
MONGO_INITDB_ROOT_USERNAME=prdal
MONGO_INITDB_ROOT_PASSWORD=prdal
MONGO_URL=mongodb://prdal:prdal@mongo:27017

# IA (ver ADR 0003) - configurado nas fases seguintes
AI_PROVIDER=groq
GROQ_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
