# Copie para .env na raiz para docker compose --env-file .env -f infra/docker-compose.yml up --build.
# Nunca versione .env nem cole chaves reais neste arquivo.

# Portas no host: web e api ficam em todas as interfaces; os demais servicos
# publicam so em 127.0.0.1 e nao ficam acessiveis pela rede.
WEB_PORT=5173
API_PORT=3000
AI_SERVICE_PORT=8000
DOC_SERVICE_PORT=8080
POSTGRES_PORT=5432
MONGO_PORT=27017
CHROMA_PORT=8001

# URLs entre containers e URL pública consumida pelo browser
AI_SERVICE_URL=http://ai-service:8000
DOC_SERVICE_URL=http://doc-service:8080
# Em desenvolvimento, web e api precisam usar o mesmo host: os dois localhost ou os
# dois 127.0.0.1, aqui, no CORS_ORIGINS e na barra de endereco do navegador. Com
# hosts diferentes o navegador marca a chamada como cross-site e login, cadastro e
# refresh respondem 403
VITE_API_URL=http://localhost:3000
# Strict-Transport-Security da api e do web. Deixe vazio em HTTP local; defina
# apenas quando houver TLS, por exemplo: max-age=31536000; includeSubDomains
PRDAL_HSTS=

# PostgreSQL e MongoDB: as senhas sao obrigatorias e nao tem valor padrao.
# Se os volumes ja existem, a senha nao muda ao editar o .env: use a senha com que
# o banco foi inicializado (inclusive nas URLs) ou recrie os volumes.
# PostgreSQL
POSTGRES_USER=prdal
POSTGRES_PASSWORD=change-this-local-postgres-password
POSTGRES_DB=prdal_careers
DATABASE_URL=postgresql://prdal:change-this-local-postgres-password@postgres:5432/prdal_careers

# MongoDB
MONGO_INITDB_ROOT_USERNAME=prdal
MONGO_INITDB_ROOT_PASSWORD=change-this-local-mongo-password
MONGO_DB=prdal_careers
MONGO_URL=mongodb://prdal:change-this-local-mongo-password@mongo:27017

# API
PORT=3000
# Prefixo publico das rotas da api, por exemplo /api quando o CloudFront encaminha
# /api/* para o ALB no mesmo dominio do web. Vazio deixa as rotas na raiz. O /health
# fica sempre fora do prefixo. Com prefixo, o VITE_API_URL termina nele
# (https://dominio/api) e o API_SELF_URL continua sem ele
API_PREFIXO=
API_SELF_URL=http://api:3000
# Obrigatorio: a api nao sobe sem um segredo de pelo menos 32 bytes.
# Gere um com: openssl rand -base64 48
JWT_SECRET=
BATCH_CONCURRENCY=3
STORAGE_DIR=/app/storage

# Sessao por cookie
# Origens do web autorizadas a chamar a api com cookies, separadas por virgula.
# Nunca use *. Fora de NODE_ENV=development, sem lista nenhuma origem e liberada.
CORS_ORIGINS=http://localhost:5173
# true quando a api estiver atras de HTTPS: os cookies de sessao saem com Secure
PRDAL_HTTPS=false
# Validade do refresh token em dias; o acesso dura 15 minutos
REFRESH_TTL_DIAS=7
# Segundos em que um refresh ja trocado responde 409 em vez de revogar a sessao,
# para duas abas renovando ao mesmo tempo. 0 desliga a tolerancia
REFRESH_TOLERANCIA_S=30
# Quantos proxies confiaveis ficam na frente da api (CloudFront e ALB = 2).
# 0 desliga: o X-Forwarded-For e ignorado e o limite por IP usa o IP da conexao.
TRUST_PROXY=0

# Servicos internos
# Obrigatorio: token compartilhado entre api, ai-service e doc-service, enviado no
# header X-Prdal-Servico. Sem ele ai-service e doc-service nao sobem fora de
# PRDAL_AMBIENTE=desenvolvimento. Gere um com: openssl rand -base64 48
SERVICE_TOKEN=
# producao por padrao; desenvolvimento libera /docs no ai-service e dispensa o token
PRDAL_AMBIENTE=producao

# IA: Claude pela API da Anthropic. Sem AI_MODEL o ai-service nao sobe fora de
# PRDAL_AMBIENTE=desenvolvimento; em desenvolvimento as rotas de IA degradam
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
# Teto de tokens de saida por chamada, incluindo o raciocinio adaptativo
AI_MAX_TOKENS=16000
# Retentativas do SDK em 408, 409, 429 e 5xx, com backoff exponencial e retry-after
AI_MAX_RETRIES=2
# Piso e teto, em segundos, do timeout de cada chamada ao Claude; entre eles vale o
# prazo restante que a api envia no header X-Prdal-Prazo-Ms
AI_TIMEOUT_PISO_S=5
AI_TIMEOUT_TETO_S=120
# Endpoint OTLP/HTTP que recebe um span por chamada ao Claude, por exemplo
# http://otel-collector:4318. Vazio grava uma linha de log estruturada por chamada
OTEL_EXPORTER_OTLP_ENDPOINT=
# Prazo da api, em ms, para keywords, turno do copiloto e redacoes
AI_LLM_TIMEOUT_MS=60000
# Prazo da api, em ms, para gerar e reduzir curriculo
AI_GENERATE_TIMEOUT_MS=300000

# RAG
CHROMA_HOST=chroma
CHROMA_INTERNAL_PORT=8000
EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
