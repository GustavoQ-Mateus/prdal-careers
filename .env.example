# Copie para .env na raiz para docker compose --env-file .env -f infra/docker-compose.yml up --build.
# Nunca versione .env nem cole chaves reais neste arquivo.

# Portas no host: web e api ficam em todas as interfaces; os demais servicos
# publicam so em 127.0.0.1 e nao ficam acessiveis pela rede.
WEB_PORT=5173
API_PORT=3000
AI_SERVICE_PORT=8000
DOC_SERVICE_PORT=8080
POSTGRES_PORT=5432
MONGO_PORT=27017
CHROMA_PORT=8001

# URLs entre containers e URL pública consumida pelo browser
AI_SERVICE_URL=http://ai-service:8000
DOC_SERVICE_URL=http://doc-service:8080
VITE_API_URL=http://localhost:3000

# PostgreSQL e MongoDB: as senhas sao obrigatorias e nao tem valor padrao.
# Se os volumes ja existem, a senha nao muda ao editar o .env: use a senha com que
# o banco foi inicializado (inclusive nas URLs) ou recrie os volumes.
# PostgreSQL
POSTGRES_USER=prdal
POSTGRES_PASSWORD=change-this-local-postgres-password
POSTGRES_DB=prdal_careers
DATABASE_URL=postgresql://prdal:change-this-local-postgres-password@postgres:5432/prdal_careers

# MongoDB
MONGO_INITDB_ROOT_USERNAME=prdal
MONGO_INITDB_ROOT_PASSWORD=change-this-local-mongo-password
MONGO_DB=prdal_careers
MONGO_URL=mongodb://prdal:change-this-local-mongo-password@mongo:27017

# API
PORT=3000
API_SELF_URL=http://api:3000
# Obrigatorio: a api nao sobe sem um segredo de pelo menos 32 bytes.
# Gere um com: openssl rand -base64 48
JWT_SECRET=
BATCH_CONCURRENCY=3
STORAGE_DIR=/app/storage

# Servicos internos
# Obrigatorio: token compartilhado entre api, ai-service e doc-service, enviado no
# header X-Prdal-Servico. Sem ele ai-service e doc-service nao sobem fora de
# PRDAL_AMBIENTE=desenvolvimento. Gere um com: openssl rand -base64 48
SERVICE_TOKEN=
# producao por padrao; desenvolvimento libera /docs no ai-service e dispensa o token
PRDAL_AMBIENTE=producao

# IA
AI_PROVIDER=groq
GROQ_API_KEY=
AI_MODEL=openai/gpt-oss-20b
AI_MAX_COMPLETION_TOKENS=8192
AI_REASONING_EFFORT=medium
AI_GENERATE_TIMEOUT_MS=300000

# RAG
CHROMA_HOST=chroma
CHROMA_INTERNAL_PORT=8000
EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
